# EditorConfig — quy tắc định dạng dùng chung cho VS 2022, Rider, VS Code.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# using đặt ngoài namespace, System lên đầu
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# namespace theo kiểu file-scoped (C# 10+)
csharp_style_namespace_declarations = file_scoped:warning

# var: chỉ dùng khi kiểu đã hiển nhiên
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Luôn có dấu ngoặc nhọn — tránh lỗi kinh điển khi thêm dòng vào if không ngoặc
csharp_prefer_braces = true:warning

dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# CA1848/CA2254 quá ồn ở giai đoạn dựng khung
dotnet_diagnostic.CA1848.severity = none

# Code do EF Core sinh tự động. Không áp quy tắc style lên nó — mỗi lần
# `dotnet ef migrations add` sẽ sinh lại và làm hỏng build.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0090.severity = none
