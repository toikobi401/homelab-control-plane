# Chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
#     cp .env.example .env

# ─────────────────────────────────────────────────────────────────────
# BẮT BUỘC — địa chỉ tailnet của máy chạy backend (CONTEXT.md §4).
#
# Cổng của container chỉ được publish lên đúng địa chỉ này. Để trống hoặc
# đổi thành 0.0.0.0 là phơi backend ra toàn bộ Wi-Fi nhà.
#
# Lấy giá trị bằng:  tailscale ip -4
# ─────────────────────────────────────────────────────────────────────
HUB_TAILNET_IP=100.100.100.100

# Môi trường ASP.NET Core: Production hoặc Development
ASPNETCORE_ENVIRONMENT=Production

# Múi giờ trong container
TZ=Asia/Ho_Chi_Minh
