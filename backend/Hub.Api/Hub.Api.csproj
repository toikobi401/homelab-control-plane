<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>9391a905-b649-477b-baa7-533d801e7ad9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hub.Core\Hub.Core.csproj" />
    <ProjectReference Include="..\Hub.Data\Hub.Data.csproj" />
    <ProjectReference Include="..\Hub.Manga\Hub.Manga.csproj" />
  </ItemGroup>

  <!-- §3: backend phục vụ file tĩnh của frontend, không dựng web server thứ hai.
       Chỉ chạy khi publish: lúc dev thì `npm run dev` phục vụ với hot reload, và
       build lại toàn bộ frontend mỗi lần `dotnet build` sẽ chậm không cần thiết. -->
  <Target Name="BuildFrontend" BeforeTargets="BeforePublish">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" />
    <ItemGroup>
      <FrontendDist Include="$(MSBuildProjectDirectory)/../../frontend/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDist)" DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Chạy như Windows Service: bắt tay với Service Control Manager để
         Windows biết tiến trình đã sẵn sàng. Thiếu nó thì service kẹt mãi ở
         "Start Pending" dù hub vẫn phục vụ được, và Stop/Restart-Service treo.
         Trên Linux (NAS sau này) gói này không làm gì — an toàn để tham chiếu
         vô điều kiện. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

</Project>
