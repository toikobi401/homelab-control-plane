<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Hub.Core\Hub.Core.csproj" />
    <ProjectReference Include="..\Hub.Data\Hub.Data.csproj" />
    <ProjectReference Include="..\Hub.Manga\Hub.Manga.csproj" />
  </ItemGroup>

  <!-- §3: backend phục vụ file tĩnh của frontend, không dựng web server thứ hai.
       Chỉ chạy khi publish: lúc dev thì `npm run dev` phục vụ với hot reload, và
       build lại toàn bộ frontend mỗi lần `dotnet build` sẽ chậm không cần thiết. -->
  <Target Name="BuildFrontend" BeforeTargets="BeforePublish">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" />
    <ItemGroup>
      <FrontendDist Include="$(MSBuildProjectDirectory)/../../frontend/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDist)"
          DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
